#!/usr/bin/env fish

set _ns ''

function namespace
  set _ns $argv[1]
end

function gmap
  set _name $argv[1]
  set _keys (string join '\',\'' $argv[2..])
  gsettings set "$_ns" "$_name" "['$_keys']"
end

function gset
  set _name $argv[1]
  set _value (string join '\',\'' $argv[2..])
  # gsettings set "$_ns" "$_name" $_value
end

 

